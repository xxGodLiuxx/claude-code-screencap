# Copy this file to .env (gitignored) and adjust values.
# All variables are optional; defaults work for local-only single-machine use.

# ====== Network ======

# Bind address. 0.0.0.0 listens on all interfaces (incl. VPN IP + localhost),
# 127.0.0.1 restricts to local only.
LAUNCHER_BIND_HOST=0.0.0.0
LAUNCHER_BIND_PORT=8123

# ====== HTTPS (required for getDisplayMedia from non-localhost devices) ======

# Without these, the launcher serves HTTP. getDisplayMedia is only available
# on a secure context (HTTPS or localhost). For multi-device usage, provide a
# valid cert. With Tailscale: `tailscale cert <hostname>.<tailnet>.ts.net`
# gives a free LetsEncrypt cert.
# LAUNCHER_SSL_CERT=/absolute/path/to/cert.crt
# LAUNCHER_SSL_KEY=/absolute/path/to/cert.key

# ====== Auth ======

# Bearer token is stored in OS keyring under this service/key. Defaults work
# out of the box; change only if you run multiple instances.
LAUNCHER_KEYRING_SERVICE=claude-code-screencap
LAUNCHER_KEYRING_TOKEN_KEY=launcher_bearer_token

# ====== Claude Code CLI integration ======

# When multiple WezTerm CC CLI tabs are open, pick the one whose title contains
# this string first (typically your active project directory name). Empty
# means: pick the first match.
LAUNCHER_PREFERRED_PROJECT=

# ====== External binaries ======

# WezTerm CLI (for tab listing / activation). Default looks in PATH, but
# Windows usually installs to Program Files where it's not on PATH.
WEZTERM_CLI=C:\Program Files\WezTerm\wezterm.exe

# ffmpeg (for screen recording → frame extraction). Default uses PATH.
FFMPEG_CLI=ffmpeg

# ====== Chrome CDP scripts (optional, used by scripts/start_chrome_cdp.ps1) ======

# Comma-separated list of allow-origins for Chrome's --remote-allow-origins.
# Add your launcher's public URLs (e.g. http://<hostname>.<tailnet>.ts.net:8123).
LAUNCHER_ORIGINS=http://127.0.0.1:8123

# Chrome paths (defaults to standard install locations)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_USER_DATA=%LOCALAPPDATA%\Google\Chrome\User Data
